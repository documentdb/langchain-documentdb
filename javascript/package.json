{
  "name": "@documentdb/langchain-documentdb",
  "version": "0.1.0",
  "description": "DocumentDB vector store integration for LangChain.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/documentdb/langchain-documentdb.git",
    "directory": "javascript"
  },
  "homepage": "https://github.com/documentdb/langchain-documentdb/tree/main/javascript#readme",
  "bugs": {
    "url": "https://github.com/documentdb/langchain-documentdb/issues"
  },
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"*.json\" \"*.md\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"*.json\" \"*.md\"",
    "typecheck": "tsc --project tsconfig.test.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@vitest/coverage-v8": "^4.1.11",
    "prettier": "^3.9.6",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@langchain/core": "^1.2.9",
    "mongodb": "^7.6.0"
  }
}
